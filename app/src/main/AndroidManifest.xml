<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The glasses: DAT sessions and the headset ride Bluetooth Classic. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The G2 demo camera only (DemoActivity): the phone's camera, filmed with the G2 screen drawn in. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Alerts and conversations with the phone in a pocket (JarvisService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Places (Settings → Location, off until switched on): Android's geofences need the precise
         position, and Android gives that only to an app that also asks for the approximate one. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- A place is crossed with the phone in a pocket and Jarvis closed: "Allow all the time". -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Android forgets an app's geofences when the phone restarts (location/BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".JarvisApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Jarvis"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- DAT attestation, from local.properties; "0" in Developer Mode (app/build.gradle.kts). -->
        <meta-data
            android:name="com.meta.wearable.mwdat.APPLICATION_ID"
            android:value="@string/mwdat_application_id" />
        <meta-data
            android:name="com.meta.wearable.mwdat.CLIENT_TOKEN"
            android:value="@string/mwdat_client_token" />
        <!-- Both default to on; nothing here is for Meta's analytics. -->
        <meta-data
            android:name="com.meta.wearable.mwdat.ANALYTICS_OPT_OUT"
            android:value="true" />
        <meta-data
            android:name="com.meta.wearable.mwdat.CRASH_REPORTING_OPT_OUT"
            android:value="true" />

        <service
            android:name=".JarvisService"
            android:exported="false"
            android:foregroundServiceType="microphone|connectedDevice" />

        <receiver
            android:name=".alerts.ReplyReceiver"
            android:exported="false" />

        <!-- A saved place crossed: Android's geofencing tells this, which tells Jarvis (app/location). -->
        <receiver
            android:name=".location.GeofenceReceiver"
            android:exported="false" />

        <!-- The places' geofences put back after the phone restarts or the app is updated, from the
             list kept on the phone. Exported, as Android itself sends these; it acts on nothing else. -->
        <receiver
            android:name=".location.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Kept running while an answer for the watch is on its way (Android 14's short service). -->
        <service
            android:name=".watch.WatchAskService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- The Jarvis watch app's questions, over Wear OS's Data Layer (app/watch, the link module). -->
        <service
            android:name=".watch.WatchService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/jarvis/"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <activity
            android:name=".DemoActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Meta AI comes back here after registration: the scheme set in the Wearables Developer Center. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvisglasses" />
            </intent-filter>
        </activity>
    </application>
</manifest>
